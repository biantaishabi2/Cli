# niuma 配置示例
# 复制为 .niuma.yml 使用

ai:
  # 默认 AI provider
  default: claude

  # AI provider 列表（支持多 provider）
  providers:
    claude:
      cmd: "cat {prompt_file} | CLAUDECODE= claude -p --output-format text --max-budget-usd 10 --permission-mode acceptEdits --add-dir {workdir}"
    codex:
      cmd: "codex exec -C {workdir} - < {prompt_file}"
      cmd_agent: "codex exec --full-auto -C {workdir} - < {prompt_file}"

  # 讨论阶段：多 provider "左右互搏"
  # 各 provider 独立给出方案，consolidator 汇总
  discussion:
    providers:
      - claude
      - codex
    consolidator: claude

  # 实现阶段：单 provider 执行
  implementation:
    provider: claude

# 工作流配置
workflow:
  require_plan_approval: false      # 方案定稿后是否需要人工审批
  max_iterate_rounds: 3             # 最大自动迭代轮数

# 控制层配置（Phase 3）
control:
  taskctl_bin: ""                   # taskctl 二进制路径（可选，默认自动发现）
  merge_strategy: "merge"           # PR 合并策略：merge 或 squash
  integration_branch_prefix: "integration/batch-"  # Integration 分支前缀
  max_old_branches: 3               # 保留的旧 integration 分支数
  min_prs_for_integration: 2        # 触发 integration 构建的最小 PR 数

# 环境变量覆盖：
# NIUMA_AI_DEFAULT=codex  覆盖 ai.default
# GITHUB_TOKEN=ghp_xxx   GitHub API token（必需）
